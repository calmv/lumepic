{
  "name": "lumepic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimalist self-hosted VPS image bed with fluid motion, local disk storage, and guest upload toggle.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --no-warnings src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --no-warnings dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "busboy": "^1.6.0",
    "exif-reader": "^2.0.2",
    "hono": "^4.7.4",
    "lucide-react": "^0.484.0",
    "motion": "^12.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^5.1.1"
  }
}
