# Docker Compose VPS configuration. Use a public DNS name for DOMAIN.
DOMAIN=
# Optional canonical HTTPS origin used for newly generated links.
PUBLIC_URL=
SITE_TITLE=LumePic
HARD_MAX_UPLOAD_MB=100

# deploy.sh writes a random one-time setup token into .env on first deployment.
# SETUP_TOKEN=
# Alternative for unattended provisioning. Remove after the first successful start.
# ADMIN_PASSWORD=

APP_UID=1000
APP_GID=1000
APP_MEMORY_LIMIT=1g
BACKEND_SUBNET=172.30.249.0/24
CADDY_PROXY_IP=172.30.249.2
